# Copy to .env and fill in the correct values for your deployment.
# Never commit the real .env file or actual credentials.

UPLOAD_LOCATION=/path/to/immich/library
DB_DATA_LOCATION=/path/to/immich/postgres
IMMICH_VERSION=release
DB_PASSWORD=replace-with-existing-database-password
DB_USERNAME=replace-with-database-username
DB_DATABASE_NAME=replace-with-database-name
