# Copy to .env and fill in the actual values.
# Never commit .env or put real credentials in this file.

ARRPATH=/path/to/media/
PGID=1000
PUID=1000
QBIT_HOST=replace-with-qbittorrent-host
QBIT_PASSWORD=replace-with-qbittorrent-password
QBIT_PORT=8080
QBIT_USERNAME=replace-with-qbittorrent-username
POSTGRES_PASSWORD=replace-with-postgres-password
TZ=Etc/UTC
VPN_PASSWORD=replace-with-vpn-password
VPN_USERNAME=replace-with-vpn-username
